{
  "description": "publish-guard: deny publishing commands that would leak private terms or a non-allowed email to a protected GitHub owner",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/publish-guard", "hook", "claude"],
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "^mcp__.*[Gg][Ii][Tt][Hh][Uu][Bb]",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/publish-guard", "hook", "claude"],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
